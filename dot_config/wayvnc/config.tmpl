# Listen on all interfaces; the firewall only lets VNC in over Tailscale.
address=0.0.0.0
port=5900
# Log in with your normal account password (RSA-AES encrypted).
enable_auth=true
enable_pam=true
rsa_private_key_file={{ .chezmoi.homeDir }}/.config/wayvnc/rsa_key.pem
# Allow macOS Screen Sharing (Apple Diffie-Hellman login). The session itself
# is then unencrypted by VNC, but VNC is only reachable over Tailscale, which
# encrypts it end to end.
relax_encryption=true
